#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Handle one Spawn inbox event for one account. Called by sdlca-listen through `spawn events --exec`,
# with the event JSON in $SPAWN_EVENT (or on stdin).
#
#   chat_mention     from the owner (or a sender you allow) -> run one agent turn in the right world
#                    from anyone else -> ignored silently (no reply, so nobody can probe the agent)
#   friend_request   accept it only if it comes from the owner
#   savi_*           logged
#   anything else    ignored
#
# A turn that fails or times out is kept in run/failed/<event-id>.json so you can replay it by hand.
#
# Just before the agent starts in a world's clone, and while the world's lock is held, the handler brings that clone up
# to date with the world (lib/refresh.py): fast-forward only, so it never makes a merge commit, never leaves conflict
# markers and never overwrites a local change. It logs one "WORLD <address> clone <status>/<code>: <text>" line and ends
# the prompt with a paragraph, in fixed wording, that says whether the clone is current. A direct message (no world) runs
# no update. SDLCA_REFRESH_TIMEOUT (seconds for each git call, default 60) turns it off with 0. It never fails a turn.
# The update runs before the credentials file is sourced, so provider keys are never in its environment.
# The agent command is started with SDLCA_TURN_ACCOUNT set to this account's name, for tools that take an account as an
# argument (sdlca-look refuses any account but this one inside a turn).
# It is given the git address that sdlca-worlds recorded for the world, which lib/route.py reads from worlds.json (the last
# field it prints): the update fetches from that address only and never asks the clone where the world is. A world with no
# recorded address is not updated ("skipped/unverified"): run sdlca-worlds --apply to record it.
# usage: sdlca-on-chat <account>
set -euo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
[ "$#" -eq 1 ] || die "usage: sdlca-on-chat <account>"
load_account "$1"
# The agent's tools learn whose turn this is from SDLCA_TURN_ACCOUNT (see where the agent starts, below). It is taken from the
# argument, which load_account has just checked, and not from ACCOUNT: the account's env file and the credentials file are sourced
# as shell, and either could change ACCOUNT.
TURN_ACCOUNT="$1"
EVENT="${SPAWN_EVENT:-$(cat)}"
export -n EVENT # never exported, even if the caller's environment had an EVENT: the agent must not inherit other people's chat text
# The Spawn client hands the handler the raw token in SPAWN_TOKEN. The agent never needs it (it uses
# sdlca-api, which reads the token file), so it is removed before anything else runs.
unset SPAWN_TOKEN SPAWN_EVENT

KIND="" CURSOR="" EVENT_ID="" DECISION="" SENDER="" ADDR="" CWD="" LOCK="" GIT=""
IFS=$'\t' read -r KIND CURSOR EVENT_ID DECISION SENDER ADDR CWD LOCK GIT \
  < <(printf '%s' "$EVENT" | python3 -I -B "$SDLCA_CODE_DIR/lib/route.py" 2> /dev/null) || true
if [ -z "$KIND" ]; then
  log_line "ERROR event could not be parsed; skipped"
  exit 0
fi

case "$KIND" in
  friend_request)
    "$SDLCA_CODE_DIR/bin/sdlca-friends" "$ACCOUNT" >> "$ACC/handler.log" 2>&1 || log_line "WARN friend accept failed"
    cursor_advance "$CURSOR"
    exit 0
    ;;
  savi_finished | savi_needs_you)
    log_line "SAVI-EVENT kind=$KIND"
    cursor_advance "$CURSOR"
    exit 0
    ;;
  chat_mention) ;;
  *)
    cursor_advance "$CURSOR"
    exit 0
    ;;
esac

if [ "$DECISION" != "allow" ]; then
  log_line "DENIED sender=$SENDER reason=${DECISION#deny:}"
  cursor_advance "$CURSOR"
  exit 0
fi
if [ -z "${SDLCA_AGENT_CMD:-}" ]; then
  log_line "ERROR SDLCA_AGENT_CMD is not set; event left unhandled"
  exit 1
fi

RUN="$SDLCA_SPAWN_HOME/run"
mkdir -p "$RUN/failed" "$RUN/scratch/$ACCOUNT"
HANDLED="$ACC/handled.ids"
# Kept events hold raw chat text: forget the old ones (SDLCA_FAILED_KEEP_DAYS, default 30; 0 keeps them forever).
if [ "${SDLCA_FAILED_KEEP_DAYS:-30}" -gt 0 ] 2> /dev/null; then
  find "$RUN/failed" -maxdepth 1 -type f -name '*.json' -mtime +"${SDLCA_FAILED_KEEP_DAYS:-30}" -delete 2> /dev/null || true
fi

# An event that was already handled (the listener replays the last one after a crash) is not run twice.
# handled_before <id>: 0 = yes. A file that cannot be read counts as "no" (and says so): a duplicate turn is better than a lost one.
handled_before() {
  local rc=0
  python3 -I -B "$SDLCA_CODE_DIR/lib/dedupe.py" seen "$HANDLED" "$1" || rc=$?
  [ "$rc" -le 1 ] || log_line "WARN handled.ids could not be read (status $rc); treating the event as new"
  [ "$rc" -eq 0 ]
}

if [ "$EVENT_ID" != "-" ] && handled_before "$EVENT_ID"; then
  log_line "SKIP event $EVENT_ID was already handled"
  cursor_advance "$CURSOR"
  exit 0
fi

# presence_join <world> <seconds>: the agent's body joins the world and STAYS, with a software-rendered page (SDLCA_PRESENCE_RENDER, cpu by
# default; none makes a body with no page, as before). The page address is taken from the client's own "page :" line, the same way
# sdlca-look takes it, and recorded in $ACC/eye.json so that a look can attach to this body instead of joining the world cold each time
# (docs/observability.md). Nothing else the client prints is kept: a join can print credentials.
EYE_NOTE=""
presence_join() {
  local world="$1" ttl="$2" render="${SDLCA_PRESENCE_RENDER:-cpu}" page="$RUN/scratch/$ACCOUNT/eye.page" size_args="" rc=0 port t0
  [[ "$render" == cpu || "$render" == none ]] || render=cpu
  if [ "$render" = cpu ] && [ -n "${SDLCA_LOOK_WIDTH:-}" ] && [ -n "${SDLCA_LOOK_HEIGHT:-}" ] && [[ "$SDLCA_LOOK_WIDTH$SDLCA_LOOK_HEIGHT" =~ ^[0-9]+$ ]]; then
    size_args="--width $SDLCA_LOOK_WIDTH --height $SDLCA_LOOK_HEIGHT"
  fi
  EYE_NOTE=""
  rm -f "$page"
  t0="$(now_ms)"
  # shellcheck disable=SC2086,SC2016  # size_args is two flags and two numbers that were checked above; the inner shell expands its own arguments
  ( cd "$RUN/scratch/$ACCOUNT" && timeout -k 5 180 bash -c 'spawn client join "$1" --name sdlca-presence --ttl "$2" --render "$3" $4 2>&1 < /dev/null | sed -u -n -E "$5" > "$6"; exit "${PIPESTATUS[0]}"' _ "$world" "$ttl" "$render" "$size_args" \
    's#^[[:space:]]*page[[:space:]]*:[[:space:]]*(http://127\.0\.0\.1:[1-9][0-9]{0,4})([/[:space:]].*)?$#\1#p' "$page" ) || rc=$?
  trace presence.join dur_ms=$(($(now_ms) - t0)) rc="$rc" render="$render" ttl="$ttl"
  if [ "$rc" -ne 0 ]; then rm -f "$page"; return 1; fi
  if [ "$render" = cpu ]; then
    # exactly one page address, or no resident body is recorded (a look then joins cold, as before)
    if [ "$(sort -u "$page" 2> /dev/null | wc -l | tr -d ' ')" = 1 ]; then
      port="$(sort -u "$page")"
      python3 -I -B -c 'import json, os, sys, time
acc, name, cdp, world, ttl = sys.argv[1:6]
tmp = os.path.join(acc, "eye.json.tmp")
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as handle:
    json.dump({"name": name, "cdp": cdp, "world": world, "expires": time.time() + float(ttl), "ttl": int(ttl)}, handle)
os.replace(tmp, os.path.join(acc, "eye.json"))' "$ACC" sdlca-presence "$port" "$world" "$ttl" 2> /dev/null && EYE_NOTE="a resident eye for looks is at $port" || EYE_NOTE="the resident eye could not be recorded"
    else
      EYE_NOTE="no single page address was printed, so looks will join cold"
    fi
  fi
  rm -f "$page"
  return 0
}

# The owner's presence commands (/spawn, /spawn ttl <seconds>, /leave) are done here by the kit, with no agent turn and no model:
# the agent's body joins the world the message came from, or leaves. lib/command.py decides; only the owner can give one.
COMMAND="$(printf '%s' "$EVENT" | OWNER="$OWNER" python3 -I -B "$SDLCA_CODE_DIR/lib/command.py" 2> /dev/null)" || COMMAND="-"
case "$COMMAND" in
  join\ [0-9]* | leave)
    THEN=""
    case "$COMMAND" in *\ then) THEN=1 COMMAND="${COMMAND% then}" ;; esac
    if [[ "$ADDR" =~ ^@{1,2}[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
      # Nothing the client prints is kept: a join can print credentials. It runs in the account's scratch folder, never in a clone.
      ( cd "$RUN/scratch/$ACCOUNT" && timeout -k 5 20 spawn client leave --name sdlca-presence > /dev/null 2>&1 < /dev/null ) || true
      rm -f "$ACC/eye.json" # the resident body (below) is gone with the session
      if [ "$COMMAND" = leave ]; then
        log_line "PRESENCE left $ADDR (asked by $SENDER)"
      elif presence_join "$ADDR" "${COMMAND#join }"; then
        log_line "PRESENCE joined $ADDR for ${COMMAND#join } seconds (asked by $SENDER)${EYE_NOTE:+; $EYE_NOTE}"
      else
        log_line "WARN PRESENCE the join to $ADDR did not work"
      fi
    else
      log_line "WARN PRESENCE $COMMAND ignored: the message did not come from a world this account serves"
    fi
    if [ -z "$THEN" ]; then
      [ "$EVENT_ID" = "-" ] || python3 -I -B "$SDLCA_CODE_DIR/lib/dedupe.py" add "$HANDLED" "$EVENT_ID" || true
      cursor_advance "$CURSOR"
      exit 0
    fi
    ;; # "/spawn ... then <request>": the body is in, and the message goes on to the agent below
esac

# Keep a failed or refused event so it can be replayed by hand:  SPAWN_EVENT="$(cat run/failed/<id>.json)" sdlca-on-chat <account>
keep_event() {
  local name="${EVENT_ID}"
  [ "$name" != "-" ] || name="event-$(date -u +%s)"
  printf '%s' "$EVENT" > "$RUN/failed/$name.json"
}

# A cap on how many agent turns an account may start in an hour (every turn can cost money).
rate=0
python3 -I -B "$SDLCA_CODE_DIR/lib/ratelimit.py" "$ACC/runs.log" "${SDLCA_MAX_RUNS_PER_HOUR:-20}" 3600 || rate=$?
case "$rate" in
  0) ;;
  1)
    log_line "RATE-LIMITED more than ${SDLCA_MAX_RUNS_PER_HOUR:-20} agent runs in an hour; event kept in run/failed"
    keep_event
    cursor_advance "$CURSOR"
    exit 0
    ;;
  *)
    log_line "ERROR the run cap could not be checked (status $rate; is SDLCA_MAX_RUNS_PER_HOUR a number? is runs.log writable?); event left unhandled"
    exit 1
    ;;
esac

log_line "event sender=$SENDER world=$ADDR"
# One id per turn, passed to the agent's tools so their spans land in the same story (docs/observability.md). Set here, after the account's
# env file was read, so that file cannot choose it.
SDLCA_TURN_ID="t$(now_ms)-$$"
export SDLCA_TURN_ID
TURN_T0="$(now_ms)"
trace turn.start kind="$KIND" world="$ADDR" sender="$SENDER" event="$EVENT_ID"
PROMPT="$(printf '%s' "$EVENT" | python3 -I -B "$SDLCA_CODE_DIR/lib/render_prompt.py")" || {
  log_line "ERROR the prompt could not be rendered; event left unhandled"
  exit 1
}

# clone_note <status> <code> <address>
# The paragraph that ends the prompt. The kit writes it with fixed wording chosen by the status and the code: git's own
# text, or any other string that a remote can influence, is never put in a prompt. (It goes to the log only.)
clone_note() {
  local reason advice
  case "$1" in
    current | updated)
      printf 'Clone status (written by the kit): the branch that is checked out in the clone of %s was brought up to date with the world just before this turn. Other branches and any submodules were not updated.' "$3"
      return 0
      ;;
  esac
  advice='If you build, run git fetch and then git rebase --fork-point origin/main before you push (a plain rebase can bring back commits that the world removed), and never force-push.'
  case "$2" in
    ahead) reason="it has commits that are not pushed yet" ;;
    diverged) reason="the clone and the world each have commits the other lacks, or the world rewrote its history" ;;
    detached | no-upstream) reason="it is not on a branch that follows the world" ;;
    unverified) reason="its git address has not been recorded, so it was not updated; the person can run sdlca-worlds --apply" ;;
    untrusted)
      reason="its git settings were not trusted"
      advice='Do not run git in this clone: tell the person that its git settings need a look.'
      ;;
    fetch) reason="the world could not be reached" ;;
    timeout) reason="the update ran out of time" ;;
    merge) reason="something in the clone stopped the fast-forward, so some files may be changed or half updated: check git status before you trust or commit them" ;;
    not-git)
      reason="the folder is not a git clone, or it is missing"
      advice='Do not run git there: tell the person that the clone needs a look.'
      ;;
    *) reason="the update could not run" ;; # error
  esac
  printf 'Clone status (written by the kit): the clone of %s could NOT be brought up to date (%s). What you read in it may lag the latest push; say so in your reply. %s' "$3" "$reason" "$advice"
}

# ensure_ledger <folder>: each world (or the scratch folder) keeps its own ledger, <folder>/.sdlca/WORK-TODO.md, which git ignores, so the notes
# of one world never reach another and are never pushed. This is trusted code writing into a folder the agent can write to, so it
# refuses a link and writes nothing that exists.
ensure_ledger() {
  local dir="$1/.sdlca"
  [ -d "$1" ] && [ ! -L "$1" ] || return 0
  [ ! -L "$dir" ] || return 0
  mkdir -p "$dir" 2> /dev/null || return 0
  [ -L "$dir/WORK-TODO.md" ] || [ -e "$dir/WORK-TODO.md" ] || cp "$SDLCA_CODE_DIR/templates/WORK-TODO.md" "$dir/WORK-TODO.md" 2> /dev/null || true
  if [ -d "$1/.git" ] && [ ! -L "$1/.git" ] && [ ! -L "$1/.git/info" ]; then
    mkdir -p "$1/.git/info" 2> /dev/null || return 0
    [ -L "$1/.git/info/exclude" ] || grep -qxF '/.sdlca/' "$1/.git/info/exclude" 2> /dev/null || printf '/.sdlca/\n' >> "$1/.git/info/exclude" 2> /dev/null || true
  fi
}

# One writer per world: turns for the same world queue on a lock (for at most SDLCA_LOCK_WAIT seconds).
# A timeout stops a hung agent from holding the lock forever, and the agent does not inherit the lock's
# file descriptor (9>&-), so a process it leaves running in the background cannot keep the lock.
status=0
LOCK_T0="$(now_ms)"
(
  flock -w "${SDLCA_LOCK_WAIT:-3600}" 9 || exit 75
  trace lock.acquired wait_ms=$(($(now_ms) - LOCK_T0))
  # The same event can arrive twice at once (two listeners, a client retry). The copy that waited for the lock
  # looks again, so only one of them runs the agent.
  if [ "$EVENT_ID" != "-" ] && handled_before "$EVENT_ID"; then exit 76; fi
  if [ -n "${SDLCA_CREDENTIALS_FILE:-}" ]; then
    [ -r "$SDLCA_CREDENTIALS_FILE" ] || { log_line "ERROR SDLCA_CREDENTIALS_FILE is not readable; event kept in run/failed"; exit 74; }
  fi
  # Bring the world's clone up to date before the agent reads it. This runs here, with the world's lock held, so it cannot
  # race another turn in the same world. It is trusted code and the agent's tool limits do not apply to it, which is why it
  # is lib/refresh.py and not an instruction in the prompt: the kit cannot tell a read-only agent from a building one.
  # It runs BEFORE the credentials file is sourced: git, and every program git starts, never see the provider keys.
  # The answer never fails the turn. A missing, crashed, stopped or confused refresh.py counts as failed/error or failed/timeout.
  # SDLCA_REFRESH_TIMEOUT=0 (all zeros) turns it off here, so the switch does not depend on the file it switches off.
  refresh_off=""
  case "${SDLCA_REFRESH_TIMEOUT:-}" in "" | *[!0]*) ;; *) refresh_off=1 ;; esac
  if [ "$ADDR" != "-" ] && [ -z "$refresh_off" ]; then
    # refresh.py bounds each git call itself. This bounds the whole run (a hung update must not hold the world's lock for
    # ever): four calls' worth, plus the ten minutes the fast-forward may take at least, plus a minute.
    refresh_limit="${SDLCA_REFRESH_TIMEOUT:-60}"
    [[ "$refresh_limit" =~ ^[0-9]{1,6}$ ]] || refresh_limit=60
    refresh_limit=$((10#$refresh_limit))
    [ "$refresh_limit" -le 86400 ] || refresh_limit=86400
    refresh_cap=$((refresh_limit * 4 + 660))
    refresh_rc=0
    refresh_t0="$(now_ms)"
    refresh_answer="$(timeout -k 5 "$refresh_cap" python3 -I -B "$SDLCA_CODE_DIR/lib/refresh.py" "$CWD" "${GIT:--}" 2>> "$ACC/handler.log" 9>&-)" || refresh_rc=$?
    if [ "$refresh_rc" -eq 124 ] || [ "$refresh_rc" -eq 137 ]; then
      refresh_answer="failed"$'\t'"timeout"$'\t'"the update was stopped by the handler after $refresh_cap seconds"
    fi
    refresh_status="" refresh_code="" refresh_text=""
    case "$refresh_answer" in *$'\n'*) refresh_answer="" ;; esac # one line, or it is not an answer
    # Exactly three tab-separated, non-empty fields, or it is not an answer. (read would merge empty fields.)
    refresh_shape="^([a-z]+)"$'\t'"([a-z-]+)"$'\t'"([^"$'\t'"]+)\$"
    if [[ "$refresh_answer" =~ $refresh_shape ]]; then
      refresh_status="${BASH_REMATCH[1]}" refresh_code="${BASH_REMATCH[2]}" refresh_text="${BASH_REMATCH[3]}"
    fi
    case "$refresh_status/$refresh_code" in
      current/ok | updated/ok | skipped/off | skipped/unverified | skipped/not-git | skipped/detached | skipped/no-upstream | skipped/ahead | skipped/diverged | skipped/untrusted | failed/fetch | failed/timeout | failed/merge | failed/error) ;;
      *) refresh_status=failed refresh_code=error refresh_text="the update gave no usable answer" ;;
    esac
    refresh_text="${refresh_text//[[:cntrl:]]/ }"
    # Guides that the world's own builders wrote for agents (SDLCA_WORLD_GUIDES: clone-relative file names), read AFTER the update so that
    # they are as new as the clone. They go before the clone note, which stays the last paragraph of the prompt.
    if [ -n "${SDLCA_WORLD_GUIDES:-}" ]; then
      guides_t0="$(now_ms)"
      guides="$(python3 -I -B "$SDLCA_CODE_DIR/lib/render_prompt.py" --guides "$CWD" 2> /dev/null)" || guides=""
      [ -z "$guides" ] || PROMPT="$PROMPT"$'\n\n'"$guides"
      trace guides dur_ms=$(($(now_ms) - guides_t0)) chars="${#guides}"
    fi
    if [ "$refresh_code" != off ]; then
      log_line "WORLD $ADDR clone $refresh_status/$refresh_code: ${refresh_text:0:200}"
      PROMPT="$PROMPT"$'\n\n'"$(clone_note "$refresh_status" "$refresh_code" "$ADDR")"
    fi
  fi
  if [ -n "${SDLCA_CREDENTIALS_FILE:-}" ]; then
    # Provider keys live in one file you already keep; the agent gets them without a second copy.
    set -a
    # shellcheck disable=SC1090
    . "$SDLCA_CREDENTIALS_FILE"
    set +a
  fi
  # Optional extensions (see docs/extensions.md): only the keys an enabled extension declares, only for those that ask for inject "env",
  # read by lib/ext.py (nothing is expanded) and put in the agent's environment as quoted export lines. A bad extension or a key file
  # that others can read stops the turn the same way an unreadable SDLCA_CREDENTIALS_FILE does.
  ext_env="$(python3 -I -B "$SDLCA_CODE_DIR/lib/ext.py" env "$ACCOUNT" 2>> "$ACC/handler.log")" || {
    log_line "ERROR an enabled extension is not valid or its key file is unsafe (see above); event kept in run/failed"
    exit 74
  }
  eval "$ext_env"
  [ -z "${refresh_t0:-}" ] || trace refresh dur_ms=$(($(now_ms) - refresh_t0)) status="${refresh_answer%%$'\t'*}" rc="${refresh_rc:-0}"
  # Never run the agent in the runtime home: it holds every account's token.
  cd "$CWD" 2> /dev/null || cd "$RUN/scratch/$ACCOUNT"
  ensure_ledger "$PWD"
  agent_rc=0
  agent_t0="$(now_ms)"
  trace agent.start cwd_world="$ADDR"
  # SDLCA_TURN_ACCOUNT tells the agent's tools whose turn this is. sdlca-look takes an account as an argument (the prompt hands the
  # agent its name), so inside a turn it refuses any other one. It is set for the agent command only, and the account env file and
  # the credentials file cannot override it, because an assignment on the command line comes last.
  printf '%s\n' "$PROMPT" |
    SDLCA_TURN_ACCOUNT="$TURN_ACCOUNT" timeout -k 10 "${SDLCA_AGENT_TIMEOUT:-1800}" bash -c "$SDLCA_AGENT_CMD" 9>&- >> "$ACC/handler.log" 2>&1 || agent_rc=$?
  trace agent.end dur_ms=$(($(now_ms) - agent_t0)) rc="$agent_rc"
  if [ "$agent_rc" -ne 0 ]; then # (set -e does not apply here: this subshell runs inside an || list)
    case "$agent_rc" in 74 | 75 | 76) agent_rc=1 ;; esac # these three are this script's own codes (see the case below)
    exit "$agent_rc"
  fi
  # Record the event while the lock is still held, so a copy waiting for the lock sees it.
  [ "$EVENT_ID" = "-" ] || python3 -I -B "$SDLCA_CODE_DIR/lib/dedupe.py" add "$HANDLED" "$EVENT_ID" ||
    log_line "WARN could not record event $EVENT_ID as handled"
  exit 0
) 9>> "$RUN/$LOCK.lock" || status=$? # append: never truncate what a link at that path points to

trace turn.end total_ms=$(($(now_ms) - TURN_T0)) status="$status"
case "$status" in
  0) ;;
  76)
    log_line "SKIP event $EVENT_ID was already handled (another copy finished first)"
    ;;
  75)
    log_line "WARN the world was busy for too long; event kept in run/failed"
    keep_event
    ;;
  74)
    keep_event # the subshell already said why
    ;;
  *)
    log_line "WARN agent exited with status $status; event kept in run/failed"
    keep_event
    ;;
esac
cursor_advance "$CURSOR"
