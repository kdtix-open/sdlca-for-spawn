# Account env: $SDLCA_SPAWN_HOME/accounts/<account>/env   (the kit sources it as shell: mode 0600, yours alone)
OWNER=alice                                  # the Spawn user this agent account works for
SPAWN_USERNAME=alice_helper                  # this agent account's own Spawn username
SPAWN_TOKEN_FILE=/home/you/.sdlca/spawn/accounts/alice/token

# REQUIRED before any agent runs. The command that performs one agent turn; the prompt arrives on stdin.
# Nothing runs until you choose one (the listener refuses to start without it).
#
# Start with the narrowest option that does the job. Read docs/security-model.md before choosing.
#   Read-only helper (can read the world's files and answer in chat; cannot edit or run anything else):
#     SDLCA_AGENT_CMD='claude -p --allowedTools "Read" "Glob" "Grep" "Bash($SDLCA_CODE_DIR/bin/sdlca-say *)" "Bash($SDLCA_CODE_DIR/bin/sdlca-api GET *)"'
#   Builder with an explicit tool allowlist (verified with Claude Code 2.1; adjust to your needs). Edits are
#   allowed; shell commands are limited to the ones listed. $SDLCA_CODE_DIR is expanded when the command runs.
#     SDLCA_AGENT_CMD='claude -p --permission-mode acceptEdits --allowedTools "Bash(git *)" "Bash(spawn *)" "Bash($SDLCA_CODE_DIR/bin/sdlca-say *)" "Bash($SDLCA_CODE_DIR/bin/sdlca-api *)" "Bash($SDLCA_CODE_DIR/bin/sdlca-look *)"'
#   Full autonomy: the agent can run any command as you. Only for a machine and an owner you fully trust.
#     SDLCA_AGENT_CMD='claude -p --permission-mode bypassPermissions'
# Any CLI that reads a prompt on stdin works (Codex, OpenCode, Cursor agent, ...): see docs/configuration.md.
# SDLCA_AGENT_CMD=

# Optional
# SDLCA_AGENT_TIMEOUT=1800                   # seconds before a turn is stopped (frees the per-world lock)
# SDLCA_LOCK_WAIT=3600                       # seconds a turn waits for the world's lock before it is kept for replay
# SDLCA_MAX_RUNS_PER_HOUR=20                 # cap on agent turns per hour for this account (0 turns the cap off)
# SDLCA_SAY_MAX_LINES=8                      # longest reply, in chat lines of at most 200 characters
# SDLCA_FAILED_KEEP_DAYS=30                  # how long kept events (run/failed) are stored; 0 keeps them forever
# SDLCA_CREDENTIALS_FILE=/path/to/.env       # provider API keys, sourced for the agent only (no second copy)
# SDLCA_REPOS=/home/you/repos                # where world clones live: <SDLCA_REPOS>/<owner>/<world>
# SDLCA_GIT_NAME=sdlca-agent                 # commit identity inside world clones
# SDLCA_GIT_EMAIL=sdlca-agent@users.noreply.invalid
