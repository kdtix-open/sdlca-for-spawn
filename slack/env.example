# Copy to $SDLCA_SPAWN_HOME/slack/sdlca-slack.env and chmod 0600. Never commit it or paste it into a chat.
SDLCA_SLACK_BOT_TOKEN="xoxb-<paste the bot token here>"
SDLCA_SLACK_APP_TOKEN="xapp-<paste the app-level token here>"
# Provider API keys are not stored here. Point SDLCA_CREDENTIALS_FILE (in the account env) at the one
# file you already keep them in, so there is only ever one copy.
