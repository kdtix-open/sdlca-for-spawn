#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Test shim for bun: records the call and succeeds. For the tests of sdlca-look's screenshot step:
#   SHIM_BUN_FAIL=1        prints an error and fails, like a screenshot tool that could not reach the page
#   SHIM_BUN_HANG=<n>      hangs for n seconds, like a screenshot that never finishes
#   SHIM_BUN_NO_FILE=1     succeeds without making a picture
#   SHIM_BUN_BUSY=<n>      the first n calls of the screenshot tool say that the page did not answer in time and exit with status 3
#   SHIM_BUN_FAIL_FROM=<n> the screenshot tool fails from its nth call on (a look takes several pictures when the first ones are blank)
#   SHIM_BUN_SIZES="<n> <n> ..."   the size in bytes of the picture that the 1st, 2nd, ... call of the screenshot tool makes (the last one
#                          repeats). The default is 30000, a real picture: sdlca-look counts anything under 20000 bytes as blank.
# The screenshot tool's calls are counted in $SHIM_OUT/bun.calls (when SHIM_OUT is set).
#   SHIM_PLANT_LINK=<link>=<target>   makes a symbolic link at <link> that points to <target> (an empty folder at <link> is replaced by it),
#                          as somebody who is watching the look would do while it runs (after the join, before the picture is placed)
#   SHIM_PLANT_FILE=<path>=<text>     makes a file at <path> that holds <text>, in the same way
# The screenshot tool (lib/shot.mjs <cdp-url> <out.png> <wait>) writes a small stand-in picture at the path it is given. Its process id
# goes to $SHIM_OUT/bun.pid (when SHIM_OUT is set), so a test can see that a hung one was really stopped.
# Like the real thing, it loads ./bunfig.toml and ./.env from the folder it starts in: when either is there it writes
# $SHIM_OUT/loaded-from-cwd. It logs "BUN-CWD: <the folder it started in>".
printf 'BUN: %s\n' "$*" >> "${SHIM_LOG:-/dev/null}"
printf 'BUN-CWD: %s\n' "$PWD" >> "${SHIM_LOG:-/dev/null}"
for loaded in bunfig.toml .env; do
  [ ! -e "./$loaded" ] || echo "bun shim: loaded ./$loaded from $PWD" >> "${SHIM_OUT:-/dev/null}/loaded-from-cwd"
done
[ -z "${SHIM_OUT:-}" ] || echo "$$" > "$SHIM_OUT/bun.pid"
call=0
case "${1:-}" in
  */shot.mjs)
    call=1
    if [ -n "${SHIM_OUT:-}" ]; then
      call=$(($(cat "$SHIM_OUT/bun.calls" 2> /dev/null || echo 0) + 1))
      echo "$call" > "$SHIM_OUT/bun.calls"
    fi
    ;;
esac
if [ -n "${SHIM_BUN_BUSY:-}" ] && [ "$call" -ge 1 ] && [ "$call" -le "$SHIM_BUN_BUSY" ]; then
  echo "shot.mjs: the page did not answer in time; it is busy drawing" >&2
  exit 3
fi
if [ -n "${SHIM_BUN_FAIL:-}" ] || { [ -n "${SHIM_BUN_FAIL_FROM:-}" ] && [ "$call" -ge "$SHIM_BUN_FAIL_FROM" ]; }; then
  echo "shot.mjs: the page is gone (shim)" >&2
  exit 1
fi
[ -z "${SHIM_BUN_HANG:-}" ] || exec sleep "$SHIM_BUN_HANG"
if [ -n "${SHIM_PLANT_LINK:-}" ]; then
  rmdir "${SHIM_PLANT_LINK%%=*}" 2> /dev/null || true
  ln -s "${SHIM_PLANT_LINK#*=}" "${SHIM_PLANT_LINK%%=*}"
fi
[ -z "${SHIM_PLANT_FILE:-}" ] || printf '%s' "${SHIM_PLANT_FILE#*=}" > "${SHIM_PLANT_FILE%%=*}"
case "${1:-}" in
  */shot.mjs)
    if [ -z "${SHIM_BUN_NO_FILE:-}" ]; then
      size=30000
      if [ -n "${SHIM_BUN_SIZES:-}" ]; then
        read -r -a sizes <<< "$SHIM_BUN_SIZES"
        index=$((call - 1))
        [ "$index" -lt "${#sizes[@]}" ] || index=$((${#sizes[@]} - 1))
        size="${sizes[$index]}"
      fi
      printf '\211PNG\r\n\032\nstand-in picture\n' > "$3"
      head -c "$size" /dev/zero >> "$3"
    fi
    ;;
esac
exit 0
